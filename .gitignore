node_modules
dist
.DS_Store
*.local

# файлы окружения — сюда попадает токен бота
.env
.env.*
!.env.example

# прочий локальный мусор
coverage
*.log

# временный конфиг Vite: каждый процесс vite, vite-node и vitest пишет рядом с vite.config.ts
# собранный `vite.config.ts.timestamp-<время>-<случайное>.mjs` и через миллисекунды стирает.
# Неигнорируемым он попадал в неотслеживаемые `git ls-files --others`, исчезал до `git hash-object`
# и ронял подсчёт замыканий (`scripts/lib/tree.ts`, тест `repo.test.ts`), когда рядом стартовал
# vite-node — дочерний процесс веера в тестах или отчёт.
*.timestamp-*.mjs

# снимки стенда-витрины (?showcase=...&snap=имя)
snaps
.city-shots
# снимки самопроверки ролика боя TW (`npm run tw:shots`, docs/battle_tw.md, раздел 9)
.battle-shots

# снимки пакета передачи визуала: их пересоздаёт стенд с любого коммита,
# в репозитории остаются только README, копии palette.ts/figures.md и замеры
docs/handoff/shots

# одноразовые пробники приёмки: сессия кладёт сюда скрипт, чтобы что-то
# посчитать или сверить, и он живёт до конца задачи. В историю им не надо.
.tmp-review/

# исходники музыки: два пака по сотням мегабайт WAV. В репозиторий им не надо —
# из них собираются mp3 в public/assets/music/, а откуда паки и что из них
# взято, записано в assets-src/MUSIC.md
assets-src/Medieval Music Vol.1 by gabone_audio/
assets-src/Combat Pack - vol 1/

# исходники географии: 23 МБ Natural Earth. В репозиторий им не надо — из них
# собирается src/world/atlas/data.ts, а откуда они взяты, записано в
# assets-src/world/SOURCES.md
assets-src/world/cache/

# исходники текстур предыстории: карты Poly Haven 1k, ~16 МБ JPEG. В репозиторий им не надо —
# из них собирается public/assets/prologue/, а откуда они, записано в src/prologue/textures.ts
# и docs/prologue.md, раздел 21; качает их `npm run textures:build -- --fetch`
assets-src/prologue/cache/

# снимки стенда карты нового вида (?showcase=map-tw): петля самопроверки, в историю им не надо
.map-shots/

# снимки петли самопроверки интерфейса (стенд сессии `.tmp-review/ui-shots.ts`): в историю им не надо
.ui-shots/
# снимки стенда промыслов (`npm run mini:shots`, docs/minigames.md)
.mini-shots/
