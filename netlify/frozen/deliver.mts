/**
 * Доставка уведомлений — функция по расписанию, раз в минуту. Первая фоновая работа
 * сервера (docs/NOTIFY.md, раздел 3).
 *
 * В этой пачке она проходит всю цепочку — метки индекса, запись исходящих, правила
 * отправки, условную отметку «ушло» — и **не отправляет ничего**: адаптеров нет ни одного.
 * Вместо отправки каждый проход кладёт счётчик в `tribe-notify-stats`: сколько созрело,
 * сколько ушло бы, сколько отброшено и почему. Ключей игроков в счётчиках нет.
 *
 * Работает только на опубликованной выкладке: на предпросмотрах и ветках Netlify
 * расписание не запускает. По адресу её не вызвать — путь ей не объявлен.
 *
 * Ключ записи исходящих здесь берётся **только из метки индекса** и только вида `tg-<число>`
 * (`lib/deliver.ts`); подписи у прохода нет, и собрать ключ больше не из чего.
 *
 * ЗАМОРОЖЕНА (16.09.2026, docs/SUBTRACT.md). Лежит в `netlify/frozen/`, а не в
 * `netlify/functions/`, и платформа её не собирает: просыпаться 1 440 раз в сутки, не
 * отправляя ничего, незачем — адаптеров нет, `NOTIFY_ON` выключен. Снять одно расписание
 * было нельзя: функция без `schedule` и без `path` отвечает всякому по адресу
 * `/.netlify/functions/deliver`, и проход доставки запускал бы кто угодно. Код, его тесты и
 * замки по исходникам (`lib/server.test.ts`) остаются в силе.
 *
 * Вернуть — перенести файл обратно, одной командой, и тем же коммитом поправить тест
 * «доставка заморожена» в `lib/server.test.ts`:
 *
 *     git mv netlify/frozen/deliver.mts netlify/functions/deliver.mts
 */
import type { Config } from '@netlify/functions';
import { blobsStores } from '../lib/blobs.js';
import { deliverPass, passIoOf } from '../lib/deliver.js';

export const config: Config = { schedule: '* * * * *' };

export default async (): Promise<Response> => {
  await deliverPass(passIoOf(blobsStores()), Date.now(), Date.now);
  return new Response(null, { status: 204 });
};
