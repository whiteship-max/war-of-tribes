{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Сервер собирает общие с игрой правила боя (`lib/war.ts` → `src/world/fights.ts`), а они пишут `@/`.
    // esbuild Netlify берёт пути из корневого `tsconfig.json` сам; свой сервер — из `vps/build.mjs`.
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["**/*.ts", "**/*.mts"]
}
