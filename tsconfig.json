{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client"]
  },
  // Отчёты приёмки живут в `scripts/` и типов до сих пор не знали: `vite-node`
  // их только транспилирует. Изменилась подпись — отчёт молча начинал считать
  // мусор, и ловилось это глазами в таблице. Теперь они проверяются вместе со
  // всем остальным.
  "include": ["src", "vite.config.ts", "scripts"]
}
