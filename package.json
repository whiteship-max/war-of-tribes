    "typecheck": "tsc --noEmit && tsc -p netlify --noEmit",
    "battle:report": "vite-node scripts/battle-report.ts",
    "pop:report": "vite-node scripts/pop-report.ts",
    "world:report": "vite-node scripts/world-report.ts",
    "settle:report": "vite-node scripts/settle-report.ts",
    "raid:report": "vite-node scripts/raid-report.ts",
    "siege:report": "vite-node scripts/siege-report.ts",
    "lair:report": "vite-node scripts/lair-report.ts",
    "sack:report": "vite-node scripts/sack-report.ts",
    "tap:report": "vite-node scripts/tap-report.ts",
    "prologue:report": "vite-node scripts/prologue-report.ts",
    "map:report": "vite-node scripts/map-report.ts",
    "figure:report": "vite-node scripts/figure-report.ts",
    "battle:sweep": "vite-node scripts/battle-sweep.ts",
    "log:report": "vite-node scripts/log-report.ts",
    "music:build": "node scripts/build-music.mjs",
    "scene:report": "vite-node scripts/scene-report.ts",
    "revive:report": "vite-node scripts/revive-report.ts",
