# Переменные окружения серверной части. Настоящий файл .env в репозиторий не
# едет (см. .gitignore) — это только образец имён.
#
# На Netlify их вписывают не сюда, а в настройки сайта:
# Site configuration → Environment variables. Локально (netlify dev) читается .env.
#
# На своём сервере (docs/SERVER.md, «Переменные») — в файл .env рядом с docker-compose.yml:
#   cp .env.example .env
#   nano .env
# В образ .env не копируется (.dockerignore): его читает docker compose и передаёт приложению.

# Токен бота из @BotFather. Им проверяется подпись initData Telegram — то
# единственное, чем игрок доказывает серверу, кто он.
#
# Без него функция сохранения не пускает никого: пустой токен считается не
# «проверка выключена», а «проверять нечем». Игра при этом работает — просто
# прогресс лежит только на устройстве. Свой сервер без токена не поднимается вовсе.
TELEGRAM_BOT_TOKEN=

# ---- Только свой сервер (docker compose). Netlify эти переменные не читает. ----

# Домен игры, например game.example.ru. Caddy сам получит для него сертификат HTTPS.
# Проверка на своей машине — http://localhost; за чужим прокси (Coolify) — :80
TRIBE_DOMAIN=

# Где лежат данные: sqlite — на диске сервера; blobs — по-прежнему на Netlify (на время переезда).
TRIBE_STORE=sqlite

# Резервные копии базы: сколько суточных хранить и во сколько снимать (время UTC, ЧЧ:ММ).
BACKUP_KEEP=14
BACKUP_AT=03:30

# Проход доставки уведомлений: off — заморожен, как на Netlify. Включать только словом владельца.
TRIBE_DELIVER=off

# Только для переноса данных с Netlify (или TRIBE_STORE=blobs). После переноса — стереть значения.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
