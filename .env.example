# Переменные окружения серверной части. Настоящий файл .env в репозиторий не
# едет (см. .gitignore) — это только образец имён.
#
# На Netlify их вписывают не сюда, а в настройки сайта:
# Site configuration → Environment variables. Локально (netlify dev) читается .env.
#
# На своём сервере (docs/SERVER.md, «Переменные») — в файл .env рядом с docker-compose.yml:
#   cp .env.example .env
#   nano .env
# В образ .env не копируется (.dockerignore): его читает docker compose и передаёт приложению.

# Токен бота из @BotFather. Им проверяется подпись initData Telegram — то
# единственное, чем игрок доказывает серверу, кто он.
#
# Без него функция сохранения не пускает никого: пустой токен считается не
# «проверка выключена», а «проверять нечем». Игра при этом работает — просто
# прогресс лежит только на устройстве. Свой сервер без токена не поднимается вовсе.
TELEGRAM_BOT_TOKEN=

# Секрет вебхука бота — кнопки «Отключить уведомления» / «Включить» под сообщениями (адрес /api/bot).
# Любая строка из латиницы, цифр, _ и - длиной до 256; ту же строку владелец передаёт в setWebhook
# (secret_token) — пошагово в docs/NOTIFY.md, раздел 12. Пусто — вебхук закрыт, кнопки не работают.
TELEGRAM_WEBHOOK_SECRET=

# ---- Только свой сервер (docker compose). Netlify эти переменные не читает. ----

# Домен игры, например game.example.ru. Caddy сам получит для него сертификат HTTPS.
# Проверка на своей машине — http://localhost; за чужим прокси (Coolify) — :80
TRIBE_DOMAIN=

# Где лежат данные: sqlite — на диске сервера; blobs — по-прежнему на Netlify (на время переезда).
TRIBE_STORE=sqlite

# Резервные копии базы: сколько суточных хранить и во сколько снимать (время UTC, ЧЧ:ММ).
BACKUP_KEEP=14
BACKUP_AT=03:30

# Проход доставки уведомлений раз в минуту: on — бот пишет о нападении и о бое (docs/NOTIFY.md, раздел 12).
# Тот же флаг на Netlify — в переменных окружения сайта. off — проход не идёт.
TRIBE_DELIVER=off

# Темп войны между игроками: во сколько раз быстрее походы и голод под лагерем (1 — обычная игра).
# Для проверки на двух аккаунтах — например, 60: поход в сутки пути идёт полчаса. В игре — 1.
TRIBE_WAR_PACE=1

# Секрет сидов войны (БЕЗ-1, docs/trust-boundary.md, 6в): из него и номера войны сервер выводит сид боя, фазы осады, падения
# города и дела лазутчика — без него клиент, видящий номер войны, мог бы просчитать исход заранее. Длинная случайная строка;
# сгенерировать прямо на сервере, не печатая значения, — командой из docs/SERVER.md, «Переменные».
# Пусто — сервер поднимается, но пишет при запуске «внимание: TRIBE_WAR_SECRET пуст». Не менять без нужды: смена секрета
# посреди войны меняет кости её следующих боёв и фаз (уже решённое не трогает).
TRIBE_WAR_SECRET=

# Адрес игры для кнопки «Открыть игру» под сообщениями бота: https://ваш-домен (тот же, что в Menu Button
# @BotFather). Пусто — кнопка ведёт на боевой адрес Netlify. Только HTTPS: иначе Telegram её не откроет.
TRIBE_APP_URL=

# Админы бота: ваш идентификатор Telegram (число), несколько — через запятую. Узнать свой — написать боту
# @userinfobot. Пусто — бот на команды админа молчит для всех (docs/admin.md).
ADMIN_IDS=

# Тест с игроками: sicily — новые игроки встают на двадцать пять мест Сицилии, защита слабого в войне между игроками
# выключена (docs/test_world.md). Пусто — обычная игра.
TRIBE_SPAWN=

# Оплата алмазов USDT в сети TON (docs/payments.md). Пусто TON_WALLET — оплата выключена.
# Сеть: testnet (умолчание) или mainnet — переход в основную сеть одной этой строкой (и мастер USDT ниже).
TON_NETWORK=testnet
# Адрес кошелька проекта (куда приходят USDT). Только адрес — мнемоника на сервер не кладётся никогда.
TON_WALLET=
# Мастер жетона USDT. В основной сети пусто — официальный USD₮ (EQCxE6mU…); в тестовой — адрес своего тестового жетона.
TON_USDT_MASTER=
# Знаков после запятой у жетона: у USD₮ — 6.
TON_USDT_DECIMALS=6
# Ключ API toncenter (@toncenter в Telegram). Без ключа — раз в секунду на всех.
TON_API_KEY=
# Свой адрес API (не обязательно): пусто — toncenter нужной сети.
TON_API_URL=

# Только для переноса данных с Netlify (или TRIBE_STORE=blobs). После переноса — стереть значения.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
